# Server
PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ADMIN_EMAIL=admin@example.com
# Generate with: node -e "console.log(require('bcryptjs').hashSync('Choose-A-Strong-Password', 12))"
ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash
DATABASE_PATH=./data/rfid.sqlite

# ThingSpeak channel read access (server-side only)
THINGSPEAK_CHANNEL_ID=3555994
THINGSPEAK_READ_API_KEY=
THINGSPEAK_RESULTS=100

# ESP32 -> backend device API token (separate from ThingSpeak keys)
DEVICE_API_TOKEN=replace-with-a-different-long-random-token

# Optional: allow secure cookies behind Render/other HTTPS proxy
TRUST_PROXY=1
